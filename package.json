{
  "name": "fridge-app",
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-native/metro-config": "0.86.3",
    "expo": "~57.0.32",
    "expo-asset": "~57.0.21",
    "expo-constants": "^57.0.23",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "^57.0.21",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "^57.0.21",
    "expo-linking": "^57.0.12",
    "expo-router": "^57.0.30",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "react-dom": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "server:dev": "python server/dev_api.py",
    "test:stage6:server": "python -m unittest discover -s server -p test_dev_api.py -v",
    "test:stage6:client": "python server/run_client_check.py",
    "test:stage7": "python -m unittest discover -s server -p \"test_*.py\" -v",
    "experiment:stage7": "python server/compare_trust_policies.py",
    "test:stage7:http": "python server/check_trust_http.py",
    "experiment:purchase": "node scripts/stage8-purchase-eval.mjs",
    "test:personal": "python server/check_personal_flow.py",
    "server:service": "python server/service.py",
    "test:service": "python server/check_service_flow.py",
    "test:sync": "node scripts/sync-controller-check.mjs",
    "test:native-linking": "node scripts/check-native-linking.mjs",
    "test:tokenizer": "tsx test-tokenizer.ts",
    "calibrate:threshold": "python scripts/calibrate_threshold.py assets/models/ko-sroberta/model_int8.onnx assets/models/ko-sroberta/tokenizer.json"
  },
  "private": true
}
