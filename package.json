{
  "name": "fridge-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.20",
    "expo-constants": "^57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "^57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "^57.0.20",
    "expo-linking": "^57.0.12",
    "expo-router": "^57.0.25",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.29.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "react-dom": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "model:prepare": "node scripts/prepare-stage2-model.mjs",
    "test:stage2": "node scripts/stage2-parity.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:stage3": "node scripts/stage3-catalog-check.mjs",
    "stage4:prepare": "node scripts/stage4-export.mjs",
    "test:stage4": "python -m unittest discover -s scripts -p test_stage4_metrics.py -v",
    "benchmark:stage4": "python scripts/stage4_compare.py",
    "model:prepare:fp32": "node scripts/prepare-stage2-model.mjs --fp32",
    "model:quantize": "python scripts/stage5_quantize.py",
    "benchmark:stage5": "python scripts/stage5_benchmark.py",
    "test:stage5": "node scripts/stage5-semantic-check.mjs",
    "server:dev": "python server/dev_api.py",
    "test:stage6:server": "python -m unittest discover -s server -p test_dev_api.py -v",
    "test:stage6:client": "python server/run_client_check.py",
    "test:stage7": "python -m unittest discover -s server -p \"test_*.py\" -v",
    "experiment:stage7": "python server/compare_trust_policies.py",
    "test:stage7:http": "python server/check_trust_http.py",
    "verify:stage8": "python scripts/verify_stage8.py",
    "test:stage8:flow": "python server/check_full_flow.py",
    "experiment:purchase": "node scripts/stage8-purchase-eval.mjs",
    "test:personal": "python server/check_personal_flow.py",
    "verify:review": "python scripts/verify_review.py"
  },
  "private": true
}
