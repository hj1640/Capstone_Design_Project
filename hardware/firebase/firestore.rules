rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authorized() {
      // Replace with the REAL test UID before publishing. Default is intentionally unusable.
      return request.auth != null && request.auth.uid == 'FBLjhgO6qLcL43XpfxxDcIwlvZc2';
    }
    match /devices/{id} { allow read, write: if authorized(); }
    match /capture_sessions/{id} { allow read, write: if authorized(); }
    match /capture_commands/{id} { allow read, write: if authorized(); }
    match /analysis_results/{id} { allow read, write: if authorized(); }
    match /{document=**} { allow read, write: if false; }
  }
}
